# Gresbase Docker Compose environment — copy to `.env` and fill in.
#   cp docker/.env.example docker/.env
#
# NEVER commit the real .env. Both values below are REQUIRED; the stack
# refuses to start without them.

# Strong, explicit JWT signing key (>= 32 chars). Generate one with:
#   openssl rand -hex 32
# The binary rejects placeholder/generated secrets in production.
JWT_SECRET=

# Strong PostgreSQL password.
POSTGRES_PASSWORD=

# Comma-separated browser origins allowed to call the API (CORS).
# Must be explicit in production (no wildcard).
CORS_ALLOWED_ORIGINS=https://app.example.com

# Public base URL — used for email links and WebAuthn.
DOMAIN=https://app.example.com
