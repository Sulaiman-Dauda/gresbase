# Gresbase

# Dependencies
node_modules/
.pnp
.pnp.js

# Build
dist/
build/
.next/
out/
*.exe
*.dll
*.so
*.dylib

# Testing
coverage/
.nyc_output/

# Environment
.env
.env.local
.env*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Storage (runtime file storage only — NOT the internal/storage source package)
/storage/
/backend/storage/
.backups/

# Runtime-generated collection schema migrations (each deployment commits its
# own ./gb_migrations; the source repo does not ship example user collections)
/gb_migrations/
backend/gb_migrations/

# Runtime-generated JS hooks directory
/gb_hooks/
backend/gb_hooks/

# Embedded PostgreSQL data (single-binary mode)
gresbase_data/
backend/gresbase_data/
# The embedded frontend. `dist/` above excludes the directory outright, and git
# does not descend into an excluded directory — so re-include the directory
# itself first, or the PLACEHOLDER negation below never applies and the backend
# cannot build from a clean clone.
!backend/internal/ui/dist/
backend/internal/ui/dist/*
!backend/internal/ui/dist/PLACEHOLDER

# Logs
*.log

# Go
vendor/
backend/gresbase
backend/gresbase_*

# Temp
tmp/
temp/

# Dart / Flutter SDK build cache — a 24MB snapshot was committed here once
.dart_tool/
.packages
.pub-cache/

# Secrets
.env
.env.*
!.env.example
*.pem
*.key
