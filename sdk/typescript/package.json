{
  "name": "gresbase-sdk",
  "version": "0.3.0",
  "description": "Isomorphic TypeScript SDK for Gresbase — authentication, CRUD, realtime, file upload",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "gresbase",
    "backend",
    "sdk",
    "authentication",
    "realtime",
    "pocketbase"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gresbase/gresbase"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^1.6.0"
  }
}
