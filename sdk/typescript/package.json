{
  "name": "gresbase-sdk",
  "version": "0.4.0",
  "description": "Isomorphic TypeScript SDK for Gresbase — authentication, CRUD, realtime, file upload",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json && node scripts/finalize-esm.mjs",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "gresbase",
    "backend",
    "baas",
    "pocketbase-alternative",
    "postgres",
    "realtime",
    "sdk",
    "authentication"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gresbase/gresbase.git",
    "directory": "sdk/typescript"
  },
  "homepage": "https://github.com/gresbase/gresbase#readme",
  "bugs": {
    "url": "https://github.com/gresbase/gresbase/issues"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^1.6.0"
  }
}
